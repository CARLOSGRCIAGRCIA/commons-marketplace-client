# Rendered by the nginx image entrypoint: envsubst over
# /etc/nginx/templates/*.template using the container's environment.
#
# This server is the SINGLE PUBLIC ENTRYPOINT of the stack (e.g. behind
# `tailscale funnel <host-port>`): it serves the Next.js client and
# transparently routes API traffic to the backend's blue-green proxy,
# so browsers talk to one origin only - no CORS, backend never exposed.
#
#   UPSTREAM_HOST / UPSTREAM_PORT      Next.js target (client color)
#     dev: client:3000 · deploy: commons-client-<color>:3000
#   API_UPSTREAM_HOST / API_UPSTREAM_PORT  backend target
#     dev: backend:5000 · deploy: commons-proxy:80

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream marketplace_client_backend {
    server ${UPSTREAM_HOST}:${UPSTREAM_PORT};
}

upstream marketplace_api_backend {
    server ${API_UPSTREAM_HOST}:${API_UPSTREAM_PORT};
}

server {
    # TLS terminates upstream (tailscale funnel / edge), so plain HTTP
    # is enough here.
    listen 80;

    # app parses JSON bodies up to 10mb upstream; keep headroom here
    client_max_body_size 12m;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript
               application/xml image/svg+xml;
    gzip_min_length 1024;

    # ── Backend passthrough (same origin => no CORS) ──────────────────
    location /api/ {
        proxy_pass http://marketplace_api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout                 300s;
    }

    location /socket.io/ {
        proxy_pass http://marketplace_api_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host       $host;
        proxy_read_timeout          300s;
        proxy_send_timeout          300s;
    }

    # ── Next.js client ────────────────────────────────────────────────
    # Content-hashed assets: cache aggressively at the edge
    location /_next/static/ {
        proxy_pass http://marketplace_client_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://marketplace_client_backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket upgrades (socket.io falls back to polling otherwise)
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout          300s;
        proxy_send_timeout          300s;
    }
}
