# Rendered by the nginx image entrypoint: envsubst over
# /etc/nginx/templates/*.template using the container's environment.
# UPSTREAM_HOST / UPSTREAM_PORT select the Next.js target:
#   - compose development: the 'client' service (see docker-compose.yml)
#   - blue-green servers: a commons-client-<color> container on the
#     commons-net network, same pattern as the API reverse proxy.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream marketplace_client_backend {
    server ${UPSTREAM_HOST}:${UPSTREAM_PORT};
}

server {
    listen 443 ssl;
    ssl_certificate     /etc/nginx/certs/cert.pem;
    ssl_certificate_key /etc/nginx/certs/key.pem;

    # app parses JSON bodies up to 10mb upstream; keep headroom here
    client_max_body_size 12m;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript
               application/xml image/svg+xml;
    gzip_min_length 1024;

    # Content-hashed assets: cache aggressively at the edge
    location /_next/static/ {
        proxy_pass http://marketplace_client_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # socket.io (chat) needs long-lived, upgraded connections
    location /socket.io/ {
        proxy_pass http://marketplace_client_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host       $host;
        proxy_read_timeout          300s;
        proxy_send_timeout          300s;
    }

    location / {
        proxy_pass http://marketplace_client_backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket upgrades (socket.io falls back to polling otherwise)
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout          300s;
        proxy_send_timeout          300s;
    }
}
